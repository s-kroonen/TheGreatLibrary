# --- Local dev (npm run dev) ---
DATABASE_URL="postgres://librarian:librarian@localhost:5432/greatlibrary"
BETTER_AUTH_SECRET="change-me-to-a-random-32-byte-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- Docker Compose / Portainer stack ---
# DATABASE_URL is assembled by docker-compose.yml from these; you don't set
# it directly when deploying the stack.
#
# Leave these commented out for local dev: `docker compose` also reads this
# file, so an uncommented POSTGRES_PASSWORD here makes the dev Postgres
# container use it while DATABASE_URL above still says "librarian" —
# "password authentication failed" on every connection.
# POSTGRES_USER=librarian
# POSTGRES_PASSWORD="change-me"
# POSTGRES_DB=greatlibrary
# APP_PORT=3000
#
# Postgres is also published on this host port for external DB tools —
# same credentials as above. Leave commented for the default (5432); set
# it if that port's already taken, or you want it on a non-default port.
# Exposes the DB to anything that can reach this host and knows
# POSTGRES_PASSWORD — fine on a trusted LAN, not something to put on an
# untrusted network without tightening docker-compose.yml's binding.
# POSTGRES_PORT=5432

# --- Optional: Google Books API key ---
# Without this, book search shares Google's low, per-IP anonymous quota,
# which is the main cause of "the same search sometimes finds nothing."
# Free, no billing required for normal usage — see DEPLOY.md for how to
# get one. Leave unset to keep using the anonymous quota.
GOOGLE_BOOKS_API_KEY=

# --- Optional: Open Library contact ---
# Open Library has no API key, but per their own policy an unidentified
# request is capped at 1 req/s while one with a descriptive User-Agent +
# contact gets 3 req/s. Set this to your email to get the full 3x; leave
# unset and the app still identifies itself by its repo URL instead
# (better than nothing, just not eligible for the full rate per their
# policy, which specifically asks for an email or phone number).
OPEN_LIBRARY_CONTACT=

# --- Optional, but recommended: Hardcover API key ---
# Open Library has essentially no series data for a lot of newer indie/
# romance/romantasy titles — Hardcover (hardcover.app) is a modern
# Goodreads alternative specifically strong on that catalog, and fills in
# series detection for books Open Library has nothing on. Free:
#   1. Create a free account at hardcover.app
#   2. Go to Settings -> Hardcover API -> New API Key
#   3. Paste the token below (no quotes needed)
# Free tier is 5,000 requests/day — far more than a personal library needs.
# Leave unset to skip Hardcover entirely; everything still works with
# just Google Books + Open Library, just with less series coverage for
# newer/indie titles.
HARDCOVER_API_KEY=

# --- One-shot: force a full series recheck ---
# Normally a book already checked in the last 7 days is skipped on boot,
# to avoid re-hitting the network (and Hardcover's free-tier quota) for
# no reason. Set this to "true" for one boot right after adding a new
# provider (or changing detection logic) so every still-unlinked book
# gets retried immediately instead of waiting out its cooldown. Set it
# back to unset/false afterward — leaving it on defeats the point of the
# cooldown and will slow every boot down for no benefit once the backlog
# is cleared.
FORCE_SERIES_RECHECK=
